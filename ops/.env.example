# Copy to ops/.env on the installation host. Never commit the populated file.
POSTGRES_DB=voxura
POSTGRES_USER=voxura_service
# Use a generated URL-safe value. The Compose database URL embeds this value,
# so reserved URI characters such as : / @ ? # [ ] are rejected by preflight.
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
CLINICAL_AUTH_MODE=proxy
CLINICAL_TRUSTED_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CLINICAL_TRUSTED_PROXY_MAX_AGE_SECONDS=60
CLINICAL_MAX_DICOM_BYTES=536870912
CLINICAL_MAX_IMPORT_FILES=2000
CLINICAL_MAX_IMPORT_BYTES=2147483648
VOXURA_BIND_ADDRESS=127.0.0.1
VOXURA_PORT=8080
VOXURA_DATABASE_MEMORY_LIMIT=2g
VOXURA_DATABASE_CPUS=2.0
VOXURA_API_MEMORY_LIMIT=3g
VOXURA_API_CPUS=2.0
VOXURA_MIGRATION_MEMORY_LIMIT=1g
VOXURA_MIGRATION_CPUS=1.0
VOXURA_WEB_MEMORY_LIMIT=256m
VOXURA_WEB_CPUS=1.0
